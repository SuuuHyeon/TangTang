# perf-ts 실험 전용 환경 변수. 복사해서 .env.perf 로 쓴다:  cp perf-ts/env.perf.example perf-ts/.env.perf
# 실제 서비스 키는 하나도 필요 없다. 외부 API(구글·OpenAI·CODEF·토스)는 실험에서 부르지 않아서 아무 값이나 넣어 둔다.
# 아래 값은 자리 표시용이다. 복사한 뒤 .env.perf 에서 직접 정한 값으로 바꿔 쓴다

# === MySQL ===
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-user

# === JWT ===
# k6 가 같은 값으로 토큰을 만든다. 32자 이상이면 아무 문자열이나 된다 (영문·숫자만)
JWT_SECRET=changemechangemechangemechangeme

# === 배치 주기 (ms) ===
# 평소에는 원래 값(5분)으로 둔다. [B] 실험 3에서만 DEADLINE_MS 를 2000 으로 줄인다
DEADLINE_MS=300000
EVALUATION_MS=300000

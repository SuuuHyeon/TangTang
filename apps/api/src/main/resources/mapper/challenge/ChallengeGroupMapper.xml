<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  typeAliases 를 쓰지 않는 프로젝트다. resultType 은 FQCN 으로 쓴다.
  파라미터는 #{} 만 사용한다. ${} 는 SQL Injection 위험으로 금지.

  ⚠ SQL 부등호는 &lt; 로 쓴다. 원시 < 를 쓰면 XML 파싱이 깨져 컨텍스트가 통째로 뜨지 않는다.
-->
<mapper namespace="com.kb.tangtang.challenge.mapper.ChallengeGroupMapper">

    <sql id="columns">
        g.id, g.admin_id, g.group_name, g.category_id, g.limit_amount, g.eval_type,
        g.max_members, g.start_date, g.end_date, g.invite_code, g.status, g.memo,
        g.created_at,
        c.category_name
    </sql>

    <!--
      category_id 가 NULL 이면 총소비 챌린지다. LEFT JOIN 이라 category_name 도 NULL 로 남는다.
    -->
    <sql id="fromGroup">
        FROM tbl_challenge_group g
        LEFT JOIN tbl_category c ON c.id = g.category_id
    </sql>

    <!--
      채번된 id 를 곧바로 tbl_group_member INSERT 에 써야 해서 useGeneratedKeys 를 쓴다.
      created_at 은 컬럼 기본값에 맡긴다 — 응답에 쓰지 않는 값이라 되받아올 이유가 없다.
    -->
    <insert id="insertGroup" parameterType="com.kb.tangtang.challenge.domain.ChallengeGroup"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tbl_challenge_group
            (admin_id, group_name, category_id, limit_amount, eval_type,
             max_members, start_date, end_date, invite_code, status, memo)
        VALUES
            (#{adminId}, #{groupName}, #{categoryId}, #{limitAmount}, #{evalType},
             #{maxMembers}, #{startDate}, #{endDate}, #{inviteCode}, #{status}, #{memo})
    </insert>

    <select id="findById" resultType="com.kb.tangtang.challenge.domain.ChallengeGroup">
        SELECT <include refid="columns"/>
        <include refid="fromGroup"/>
        WHERE g.id = #{groupId}
    </select>

    <select id="findByInviteCode" resultType="com.kb.tangtang.challenge.domain.ChallengeGroup">
        SELECT <include refid="columns"/>
        <include refid="fromGroup"/>
        WHERE g.invite_code = #{inviteCode}
    </select>

    <!--
      내가 참여자인 그룹만 본다. 방장 여부는 admin_id 로 따로 판정하므로
      여기서 admin_id 를 OR 로 붙이지 않는다 — 방장도 tbl_group_member 에 들어 있다.

      정렬은 시작일 내림차순. 최근 만든 챌린지가 위에 오는 게 목록 화면의 기대다.
    -->
    <select id="findMyGroups" resultType="com.kb.tangtang.challenge.domain.ChallengeGroup">
        SELECT <include refid="columns"/>
        <include refid="fromGroup"/>
        JOIN tbl_group_member m ON m.group_id = g.id AND m.user_id = #{userId}
        <if test="statuses != null and !statuses.isEmpty()">
            WHERE g.status IN
            <foreach collection="statuses" item="status" open="(" separator="," close=")">
                #{status}
            </foreach>
        </if>
        ORDER BY g.start_date DESC, g.id DESC
    </select>

    <select id="countByInviteCode" resultType="int">
        SELECT COUNT(*) FROM tbl_challenge_group WHERE invite_code = #{inviteCode}
    </select>

    <!--
      상태 전이 배치(이슈 #152). idx_cg_status_start (status, start_date) 를 탄다.
      정렬을 id 로 두는 이유는 배치 로그를 두 번 돌렸을 때 순서가 같아야 비교하기 쉬워서다.
    -->
    <select id="findGroupsToStart" resultType="com.kb.tangtang.challenge.domain.ChallengeGroup">
        SELECT <include refid="columns"/>
        <include refid="fromGroup"/>
        WHERE g.status = #{status}
          AND g.start_date &lt;= #{today}
        ORDER BY g.id
    </select>

    <!--
      평가·기소 배치(이슈 #168).

      end_date 비교가 오늘이 아니라 #{yesterday} 인 것이 핵심이다. 배치는 매 틱 어제·오늘 두 날짜를
      집계하는데, end_date &gt;= 오늘 으로 좁히면 챌린지 마지막 날 심야 거래를 처리해야 할 다음 날에
      그룹이 조회에서 빠져 그 거래가 통째로 누락된다.
      부수 효과로 이 조건은 end_date + 1일까지 그룹을 남겨 두는데, 기간평가(PERIOD) 기소를
      판정할 수 있는 마지막 날과 정확히 일치한다.

      idx_cg_status_start (status, start_date) 를 탄다. end_date 는 걸러 낸 뒤 평가되지만
      ACTIVE 그룹 수 자체가 작아 문제되지 않는다.
      정렬을 id 로 두는 이유는 findGroupsToStart 와 같다 — 배치 로그 비교를 쉽게 하기 위함.
    -->
    <select id="findGroupsToEvaluate" resultType="com.kb.tangtang.challenge.domain.ChallengeGroup">
        SELECT <include refid="columns"/>
        <include refid="fromGroup"/>
        WHERE g.status = #{status}
          AND g.start_date &lt;= #{today}
          AND g.end_date &gt;= #{yesterday}
        ORDER BY g.id
    </select>

    <!--
      [perf-ts] 평가 배치 증분 처리 (ChallengeGroupMapper#findChangedGroupIds 주석 참고).
      첫 갈래는 idx_tx_updated_at(updated_at) 으로 바뀐 거래만 범위로 읽고, 참여자는 idx_gm_user 로 찾는다.
      updated_at 인덱스가 없으면 거래 전체를 읽는다 — db/migration/20261004_add_transaction_updated_at_index.sql
      tbl_group_member.joined_at, tbl_challenge_group.updated_at 에는 인덱스가 없다. 진행 중인 그룹과
      참여자는 수천~수만 행이라 다 읽어도 수 ms 다.
    -->
    <select id="findChangedGroupIds" resultType="java.lang.Long">
        SELECT m.group_id
          FROM tbl_transaction t
          JOIN tbl_group_member m ON m.user_id = t.user_id
         WHERE t.updated_at &gt;= #{since}
           AND t.tr_date IN (#{yesterday}, #{today})
        UNION
        SELECT group_id FROM tbl_group_member WHERE joined_at &gt;= #{since}
        UNION
        SELECT id FROM tbl_challenge_group WHERE updated_at &gt;= #{since}
    </select>

    <!--
      재판 전이 배치(이슈 #169). idx_cg_status_start (status, start_date) 의 선행 컬럼만 탄다.
      end_date 는 걸러 낸 뒤 평가되지만 ACTIVE 그룹 수 자체가 작아 문제되지 않는다.

      부등호가 &lt;= 가 아니라 &lt; 인 것이 중요하다. 호출부가 today - 1일 을 넘기므로
      end_date = 어제 인 그룹(= 오늘 평가 배치가 마지막으로 봐야 하는 그룹)은 여기서 빠진다.
      이유는 ChallengeGroupMapper#findGroupsToJudge 주석에 적어 두었다.
    -->
    <select id="findGroupsToJudge" resultType="com.kb.tangtang.challenge.domain.ChallengeGroup">
        SELECT <include refid="columns"/>
        <include refid="fromGroup"/>
        WHERE g.status = #{status}
          AND g.end_date &lt; #{endedBefore}
        ORDER BY g.id
    </select>

    <!--
      최종 결과 확정 배치(이슈 #172). JUDGING → CLOSED.

      ⚠ NOT EXISTS 한 줄이 "미확정 재판이 남아 있으면 확정을 미룬다" 의 전부다.
        DEFENSE_WAIT · VOTING 인 기소가 하나라도 있으면 그 재판의 결과(목숨 차감·무죄 감액)가
        아직 반영되지 않은 상태다. final_* 3개는 write-once 라 나중에 고칠 수 없다.

      GUILTY · INNOCENT 는 이미 확정된 재판이라 조건에 넣지 않는다. 기소가 아예 없는
      그룹(전원 한도 이내로 완주)도 NOT EXISTS 가 참이라 그대로 통과한다.

      idx_ind_group (group_id, status) 를 서브쿼리가 그대로 탄다.
    -->
    <select id="findGroupsToClose" resultType="com.kb.tangtang.challenge.domain.ChallengeGroup">
        SELECT <include refid="columns"/>
        <include refid="fromGroup"/>
        WHERE g.status = #{status}
          AND NOT EXISTS (SELECT 1
                            FROM tbl_indictment i
                           WHERE i.group_id = g.id
                             AND i.status IN ('DEFENSE_WAIT', 'VOTING'))
        ORDER BY g.id
    </select>

    <!--
      조건부 상태 변경. WHERE 의 status 비교가 곧 멱등성 장치다 —
      이미 전이된 그룹은 0 행이 바뀌고, 호출부가 그걸 보고 알림을 건너뛴다.
      updated_at 은 ON UPDATE CURRENT_TIMESTAMP 라 따로 쓰지 않는다.
    -->
    <update id="updateStatusIfCurrent">
        UPDATE tbl_challenge_group
        SET status = #{toStatus}
        WHERE id = #{groupId}
          AND status = #{fromStatus}
    </update>

    <!--
      모집 미달 그룹 정리(이슈 #261). WHERE 의 status 비교는 여기서 더 중요하다 —
      조회 시점에 1명이었어도 그 사이 참여가 생겨 다른 실행이 ACTIVE 로 전이시켰을 수 있고,
      조건이 없으면 방금 시작된 그룹을 CASCADE 로 통째로 지운다. UPDATE 와 달리 되돌릴 수 없다.

      자식 행은 FK 의 ON DELETE CASCADE 가 정리한다 (schema.sql:452,469,497,548).
    -->
    <delete id="deleteIfCurrent">
        DELETE FROM tbl_challenge_group
        WHERE id = #{groupId}
          AND status = #{status}
    </delete>

    <!--
      참여 정원 경합 방어 (이슈 #354). 저장소에서 유일한 FOR UPDATE 다.

      ⚠ columns 조각을 쓰지 않는다. 그 조각은 tbl_category 를 조인하는데, FOR UPDATE 는
        조회한 모든 테이블의 행을 잠근다 — 카테고리는 모든 그룹이 공유하는 참조 테이블이라
        서로 무관한 그룹의 참여끼리 막히게 된다. 판정에 쓰는 4개 컬럼만 읽는다.
        (그래서 이 결과로 응답 DTO 를 만들면 안 된다. category_name 이 NULL 이다)

      ⚠ 잠금 순서는 tbl_challenge_group → tbl_group_member 다. 반대로 잡는 곳을 만들면 데드락.
    -->
    <select id="lockGroupForJoin" resultType="com.kb.tangtang.challenge.domain.ChallengeGroup">
        SELECT id, status, start_date, max_members
          FROM tbl_challenge_group
         WHERE id = #{groupId}
         FOR UPDATE
    </select>
</mapper>
